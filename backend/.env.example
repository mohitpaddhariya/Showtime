# ── AI Mapper ─────────────────────────────────────────────
# "groq" (cloud, default) or "ollama" (local)
SHOWTIME_LLM_PROVIDER=groq

# Groq (get free key at https://console.groq.com/keys)
SHOWTIME_GROQ_API_KEY=
SHOWTIME_GROQ_MODEL=llama-3.3-70b-versatile
# Vision model (Llama 4 Scout — SEES keyframe screenshots, same API key)
SHOWTIME_GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Ollama (local, offline)
SHOWTIME_OLLAMA_MODEL=llama3
SHOWTIME_OLLAMA_BASE_URL=http://localhost:11434

# ── AI Scene Verification ─────────────────────────────────
# After OpenCV detection, batch keyframes in 1 Llama 4 Scout call to
# confirm/merge/split segments semantically. Set false to save 1 API call.
SHOWTIME_AI_VERIFY_SCENES=true

# ── AI Mapping Tuning ─────────────────────────────────────
# Maximum freeze frames per video (prevents slideshow effect)
SHOWTIME_MAX_FREEZE_COUNT=3
# AI self-critique pacing score (0-10). Below this triggers 1 refinement call.
SHOWTIME_PACING_THRESHOLD=8.5

# ── Whisper ───────────────────────────────────────────────
# "groq" (cloud, default — fast, uses Groq API key above) or "local" (offline, slower)
SHOWTIME_WHISPER_PROVIDER=groq
SHOWTIME_GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# Local Whisper model size (only if SHOWTIME_WHISPER_PROVIDER=local): tiny | base | small | medium | large
SHOWTIME_WHISPER_MODEL=base

# ── Scene Detection ──────────────────────────────────────
SHOWTIME_SCENE_THRESHOLD=30.0
SHOWTIME_IDLE_THRESHOLD=2.0
SHOWTIME_IDLE_MIN_DURATION=1.5
SHOWTIME_SAMPLE_FPS=2

# ── Renderer ─────────────────────────────────────────────
SHOWTIME_VIDEO_CODEC=libx264
SHOWTIME_AUDIO_CODEC=aac
SHOWTIME_OUTPUT_PRESET=medium
SHOWTIME_CRF=23
# Crossfade between clips in seconds (0 = hard cut)
SHOWTIME_CROSSFADE_DURATION=0.3
# Ken Burns subtle zoom on freeze clips (prevents dead-screen effect)
SHOWTIME_KEN_BURNS_ON_FREEZE=true
# Max zoom factor for Ken Burns (1.03 = 3% zoom, very subtle)
SHOWTIME_KEN_BURNS_ZOOM=1.03
